# Spotipie bot (Go) - copy to .env and fill in
API_KEY=
BOT_USERNAME=spotipiebot
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MONGO_USR=
MONGO_PASS=
MONGO_COLL=spotipie
TEMP_CHANNEL=
REDIRECT_URI=
LASTFM_API_KEY=
ADMIN_IDS=

# Logging
LOG_LEVEL=info     # debug | info | warn | error
LOG_FORMAT=text    # text | json

# GlitchTip / Sentry (optional; leave DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.01 # 0 disables timings; 1 records every bot update

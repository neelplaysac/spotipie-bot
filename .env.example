# Spotipie bot (Go) - copy to .env and fill in
API_KEY=
BOT_USERNAME=spotipiebot
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MONGO_USR=
MONGO_PASS=
MONGO_COLL=spotipie
# Optional standard URI replaces MONGO_USR/MONGO_PASS/MONGO_COLL for connection.
# Use the same URI and database for both processes. URI path does not select DB.
MONGODB_URI=
# Defaults to MONGO_COLL, or spotipie when MONGO_COLL is unset.
MONGODB_DATABASE=
TEMP_CHANNEL=
REDIRECT_URI=
LASTFM_API_KEY=
ADMIN_IDS=

# Spotify callback server (run ./cmd/authserver alongside the bot)
PORT=6969
AUTH_HTTP_PORT=6969
# Default return link: https://t.me/<BOT_USERNAME>?start=
BOT_URL=
# Must match the GHCR image published by this repository's workflow.
SPOTIPIE_IMAGE=ghcr.io/neelplaysac/spotipie-bot:latest

# Logging
LOG_LEVEL=info     # debug | info | warn | error
LOG_FORMAT=text    # text | json

# GlitchTip / Sentry (optional; leave DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.01 # 0 disables timings; 1 records every bot update
